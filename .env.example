# ─── Database ─────────────────────────────────────────────────────────────────
# Option A: Local PostgreSQL (with docker compose up -d)
DATABASE_URL="postgresql://postgres:password@localhost:5432/learning_platform"

# Option B: Supabase (recommended for production)
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="your-secret-here"

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Options: openai | anthropic | ollama
AI_PROVIDER="openai"

# Separate embedding provider (optional — defaults to AI_PROVIDER)
# Options: openai | ollama
# Note: Anthropic has no embeddings API, so set this to openai or ollama
# EMBEDDING_PROVIDER="openai"

# ── Option 1: OpenAI (cloud) ──────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ── Option 2: Anthropic / Claude (cloud) ─────────────────────────────────────
# AI_PROVIDER="anthropic"
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
# Anthropic has no embeddings — keep OPENAI_API_KEY for embeddings
# EMBEDDING_PROVIDER="openai"

# ── Option 3: Ollama — local SLMs, no API cost ───────────────────────────────
# Install Ollama: https://ollama.com
# Then: ollama pull phi4-mini && ollama pull nomic-embed-text
#
# AI_PROVIDER="ollama"
# EMBEDDING_PROVIDER="ollama"
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL="phi4-mini"           # or: mistral | llama3.2 | gemma3:4b
# OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
#
# IMPORTANT: nomic-embed-text produces 768-dim vectors (not 1536).
# If switching to Ollama embeddings you MUST also:
#   1. Set EMBEDDING_DIMENSIONS=768
#   2. Update prisma/schema.prisma: vector(1536) → vector(768)
#   3. Run: npm run db:push  (drops and re-creates vector column)

# ── Option 4: Azure OpenAI ────────────────────────────────────────────────────
# AI_PROVIDER="azure"
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT=""
# AZURE_OPENAI_DEPLOYMENT=""
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=""
# AZURE_OPENAI_API_VERSION="2024-02-01"

# ─── Embedding / Chunking ─────────────────────────────────────────────────────
# Must match the vector dimension in prisma/schema.prisma
# OpenAI text-embedding-3-small → 1536
# Ollama nomic-embed-text       → 768
# Ollama mxbai-embed-large      → 1024
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ─── File Storage ─────────────────────────────────────────────────────────────
STORAGE_PROVIDER="local"   # local | s3 | azure-blob | gcs
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50
